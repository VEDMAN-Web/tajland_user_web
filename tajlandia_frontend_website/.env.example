# Public variables are inlined into the client bundle.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Tajlandia
NEXT_PUBLIC_API_URL=https://tajlandai-backend.onrender.com/api/v1

# Server-only. Never prefix secrets with NEXT_PUBLIC_.
API_SECRET=

NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk_test_YOUR_MAPBOX_PUBLIC_TOKEN_HERE

# Google OAuth Client ID (public). The client secret stays on the backend only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# Public contact details shown in the footer, contact page and structured data.
# Leave a value empty to hide that row (no placeholder text is ever shown).
# Use "|" for line breaks in the address.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Set to "true" on test/staging hosts so search engines never index them
# (noindex tags, robots.txt Disallow: /, empty sitemap). Leave unset in production.
NEXT_PUBLIC_NOINDEX=
